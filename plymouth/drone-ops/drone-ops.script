/*
 * DRONE OPS Plymouth Boot Theme
 * Clean boot animation: droneOps logo + rotating dot spinner
 */

// Brand colors
accent = "0.0, 0.831, 1.0";  // Cyan #00d4ff
text_color = "1.0, 1.0, 1.0"; // White

// Screen geometry
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
center_x = screen_width / 2;
center_y = screen_height / 2;

// Background gradient (dark blue #1a1a2e)
Window.SetBackgroundTopColor(0.102, 0.102, 0.18);
Window.SetBackgroundBottomColor(0.102, 0.102, 0.18);

// Logo text - "droneOps"
logo_font_size = Math.Max(screen_height * 0.08, 48);
logo_img = Image.Text("droneOps", 1.0, 1.0, 1.0, logo_font_size, "Bold");
logo_sprite = Sprite.New();
logo_sprite.SetImage(logo_img);
logo_sprite.SetPosition(center_x - logo_img.GetWidth() / 2,
                        center_y - logo_img.GetHeight() / 2 - 40, 1);
logo_sprite.SetOpacity(1);

// Loading spinner: 8 dots in a circle
spinner_size = Math.Max(screen_height * 0.04, 24);
num_dots = 8;
dot_radius = spinner_size / 2;
spinner_center_x = center_x;
spinner_center_y = center_y + logo_img.GetHeight() / 2 + 40;

spinner_dots = [];
for (i = 0; i < num_dots; i++) {
    angle = (i / num_dots) * 2 * Math.Pi;
    dot_x = spinner_center_x + Math.Cos(angle) * spinner_size - dot_radius / 2;
    dot_y = spinner_center_y + Math.Sin(angle) * spinner_size - dot_radius / 2;

    dot = Image.Text("•", 0.0, 0.831, 1.0, dot_radius, "Bold");
    dot_sprite = Sprite.New();
    dot_sprite.SetImage(dot);
    dot_sprite.SetPosition(dot_x, dot_y, 2);
    dot_sprite.SetOpacity(0.2);
    spinner_dots[i] = dot_sprite;
}

// Animation state
frame = 0;
animation_speed = 0.15;

fun animate() {
    active_index = Math.Floor(frame) % num_dots;

    for (i = 0; i < num_dots; i++) {
        // Distance from active dot (wrapping) drives the fade
        distance = i - active_index;
        if (distance < 0) distance += num_dots;

        opacity = 1.0 - (distance / num_dots);
        if (opacity < 0.2) opacity = 0.2;

        spinner_dots[i].SetOpacity(opacity);
    }

    frame += animation_speed;
}

Plymouth.SetRefreshFunction(animate);

fun quit_callback() {
    logo_sprite.SetOpacity(0);
    for (i = 0; i < num_dots; i++) {
        spinner_dots[i].SetOpacity(0);
    }
}

Plymouth.SetQuitFunction(quit_callback);
