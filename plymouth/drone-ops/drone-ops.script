/*
 * DRONE OPS Plymouth Boot Theme
 * Logo: drone-ops-logo.png (fallback to text) + Ring spinner
 */

Window.SetBackgroundTopColor(0.102, 0.102, 0.18);
Window.SetBackgroundBottomColor(0.102, 0.102, 0.18);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
center_x = screen_width / 2;
center_y = screen_height / 2;

// ── Logo ──────────────────────────────────────────────────────
// Try PNG first (sharp, two-tone: drone white + Ops cyan)
logo_image = Image("drone-ops-logo.png");
if (!logo_image) {
    // Fallback: plain text (white). Plymouth Image.Text signature:
    // Image.Text(text, red, green, blue, alpha, font, align)
    // Font must include size: "Sans Bold 48"
    logo_font = "Sans Bold 48";
    logo_image = Image.Text("droneOps", 1, 1, 1, 1, logo_font);
}

logo_sprite = Sprite(logo_image);
logo_sprite.SetPosition(center_x - logo_image.GetWidth() / 2,
                        center_y - logo_image.GetHeight() / 2 - 40, 1);
logo_sprite.SetOpacity(1);

// ── Spinner ───────────────────────────────────────────────────
// Prefer ring PNG (rotating arc, matches web Ring component).
// Fallback to 8-dot pulsing circle if ring PNG not present.

spinner_ring_image = Image("spinner-ring.png");
spinner_size = 64;
spinner_center_y = center_y + logo_image.GetHeight() / 2 + 60;

use_ring = 0;
if (spinner_ring_image) {
    use_ring = 1;
    // Scale ring to desired size (original 128x128)
    if (spinner_ring_image.GetWidth() != spinner_size) {
        spinner_ring_image = spinner_ring_image.Scale(spinner_size, spinner_size);
    }
    spinner_sprite = Sprite(spinner_ring_image);
    spinner_sprite.SetPosition(center_x - spinner_size / 2,
                               spinner_center_y - spinner_size / 2, 2);
    spinner_angle = 0;
}

// Fallback dots (8 cyan dots, opacity pulse)
num_dots = 8;
spinner_dots = [];
if (!use_ring) {
    dot_spinner_size = Math.Max(screen_height * 0.04, 24);
    dot_radius = dot_spinner_size / 2;
    spinner_center_x = center_x;
    // Use correct Image.Text signature: alpha=1, font includes size
    dot_font = "Sans Bold 24";
    for (i = 0; i < num_dots; i++) {
        angle = (i / num_dots) * 2 * Math.Pi;
        dot_x = spinner_center_x + Math.Cos(angle) * dot_spinner_size - dot_radius / 2;
        dot_y = spinner_center_y + Math.Sin(angle) * dot_spinner_size - dot_radius / 2;
        dot = Image.Text("•", 0, 0.831, 1, 1, dot_font);
        dot_sprite = Sprite(dot);
        dot_sprite.SetPosition(dot_x, dot_y, 2);
        dot_sprite.SetOpacity(0.2);
        spinner_dots[i] = dot_sprite;
    }
}

// ── Animation ─────────────────────────────────────────────────
frame = 0;
animation_speed = 0.15;

fun animate() {
    if (use_ring) {
        spinner_angle += 0.12;
        if (spinner_angle > 2 * Math.Pi) spinner_angle -= 2 * Math.Pi;
        rotated = spinner_ring_image.Rotate(spinner_angle);
        spinner_sprite.SetImage(rotated);
    } else {
        active_index = Math.Floor(frame) % num_dots;
        for (i = 0; i < num_dots; i++) {
            distance = i - active_index;
            if (distance < 0) distance += num_dots;
            opacity = 1.0 - (distance / num_dots);
            if (opacity < 0.2) opacity = 0.2;
            spinner_dots[i].SetOpacity(opacity);
        }
        frame += animation_speed;
    }
}

Plymouth.SetRefreshFunction(animate);

fun quit_callback() {
    logo_sprite.SetOpacity(0);
    if (use_ring) {
        spinner_sprite.SetOpacity(0);
    } else {
        for (i = 0; i < num_dots; i++) {
            spinner_dots[i].SetOpacity(0);
        }
    }
}

Plymouth.SetQuitFunction(quit_callback);
