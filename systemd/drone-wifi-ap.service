[Unit]
Description=DRONE OPS WiFi Access Point
Documentation=https://github.com/your-org/drone-ops-suite
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/opt/drone/scripts/setup-wifi-ap.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drone-wifi-ap

[Install]
WantedBy=multi-user.target
