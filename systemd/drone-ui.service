[Unit]
Description=DRONE OPS Kiosk Interface (Firefox)
Documentation=https://github.com/your-org/drone-ops-suite
After=graphical.target drone-api.service drone-wifi-ap.service
Wants=drone-api.service drone-wifi-ap.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/drone
Environment=DISPLAY=:0
Environment=HOME=/root
Environment=XAUTHORITY=/root/.Xauthority

# Wait for X11 and services to be ready
ExecStartPre=/bin/sleep 5
ExecStartPre=/bin/sh -c 'until pgrep -x "Xorg" > /dev/null; do sleep 1; done'
ExecStartPre=/bin/sh -c 'until curl -s http://localhost:8080/health > /dev/null 2>&1; do sleep 2; done'
ExecStart=/opt/drone/scripts/start-kiosk.sh
ExecStop=/usr/bin/pkill -f firefox

Restart=on-failure
RestartSec=5
RestartPreventExitStatus=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=drone-ui

[Install]
WantedBy=graphical.target
