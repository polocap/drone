[Unit]
Description=DRONE OPS UI Kiosk
Documentation=https://github.com/your-org/drone-ops-suite
After=graphical.target drone-api.service
Wants=drone-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/drone
ExecStart=/opt/drone/scripts/start-kiosk.sh
Restart=always
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=drone-ui

[Install]
WantedBy=graphical.target
